                </div>

                -->

                <!-- BESCHRIJVING -->

                <div class="portal-form-group--full">
                    <h2>Beschrijving*</h2>
                </div>

                <div class="portal-form-group portal-form-group--full">
                    <textarea asp-for="Input.Description"></textarea>
                    <span asp-validation-for="Input.Description"></span>
                </div>

                
                <!-- TICKETS -->
                <div class="portal-form-group--full">
                    <h2>Tickets</h2>
                </div>

                <div class="portal-form-group portal-form-group--full">
                    <button type="button" id="add-ticket-btn" class="portal-secondary-link">Ticket toevoegen</button>
                    <datalist id="ticket-name-options">
                        @foreach (var optie in Model.TicketTypeOptions)
                        {
                            <option value="@optie.Value">@optie.Text</option>
                        }
                        <option value="Entree"></option>
                        <option value="Entree kinderen"></option>
                        <option value="Entree volwassenen"></option>
                        <option value="Entree studenten"></option>
                    </datalist>
                    <template id="ticket-row-template">
                        <div class="portal-ticket-row">
                            <div class="three-columns">
                                <div class="portal-form-group">
                                    <label for="Input_Tickets_0__TicketType">Ticketnaam *</label>
                                    <input id="Input_Tickets_0__TicketType" name="Input.Tickets[0].TicketType" type="text" list="ticket-name-options" placeholder="Kies of typ een ticketnaam" maxlength="100" required data-msg-required="Vul een ticketnaam in of kies een suggestie." data-msg-maxlength="Gebruik maximaal 100 tekens voor de ticketnaam." />
                                    <span data-valmsg-for="Input.Tickets[0].TicketType" data-valmsg-replace="true"></span>
                                </div>

                                <div class="portal-form-group">
                                    <label for="Input_Tickets_0__Price">Prijs (€) *</label>
                                    <input id="Input_Tickets_0__Price" name="Input.Tickets[0].Price" type="number" value="0" min="0" max="999999" step="0.01" required data-msg-required="Vul een prijs in." data-msg-number="Vul een geldige prijs in." data-msg-min="De prijs moet € 0 of hoger zijn." data-msg-max="De prijs mag maximaal € 999.999 zijn." data-msg-step="Gebruik maximaal twee decimalen." />
                                    <span data-valmsg-for="Input.Tickets[0].Price" data-valmsg-replace="true"></span>
                                </div>

                                <div class="portal-form-group">
                                    <label for="Input_Tickets_0__Quantity">Aantal beschikbaar *</label>
                                    <input id="Input_Tickets_0__Quantity" name="Input.Tickets[0].Quantity" type="text" inputmode="numeric" required data-rule-digits="true" data-rule-range="[1,2147483647]" data-msg-required="Vul het aantal beschikbare tickets in." data-msg-digits="Vul een heel aantal van minimaal 1 in." data-msg-range="Vul een geldig aantal van minimaal 1 in." />
                                    <span data-valmsg-for="Input.Tickets[0].Quantity" data-valmsg-replace="true"></span>
                                </div>
                            </div>

                            <button type="button" class="portal-remove-ticket-btn">Verwijderen</button>
                        </div>
                    </template>
                    <div id="ticket-list" class="portal-ticket-list">
                        @if (Model.Input.Tickets != null && Model.Input.Tickets.Count > 0)
                            {
                                for (var i = 0; i < Model.Input.Tickets.Count; i++)
                                {
                                <div class="portal-ticket-row">
                                    <div class="three-columns">
                                        <div class="portal-form-group">
                                            <label asp-for="Input.Tickets[i].TicketType">Ticketnaam *</label>
                                            <input asp-for="Input.Tickets[i].TicketType" type="text" list="ticket-name-options" placeholder="Kies of typ een ticketnaam" maxlength="100" required />
                                            <span asp-validation-for="Input.Tickets[i].TicketType"></span>
                                        </div>

                                        <div class="portal-form-group">
                                            <label asp-for="Input.Tickets[i].Price">Prijs (€)</label>
                                            <input asp-for="Input.Tickets[i].Price" type="number" step="0.01" min="0" />
                                            <span asp-validation-for="Input.Tickets[i].Price"></span>
                                        </div>

                                    <div class="portal-form-group">
                                        <label asp-for="Input.Tickets[i].Quantity">Aantal beschikbaar *</label>
                                        <input asp-for="Input.Tickets[i].Quantity" type="text" inputmode="numeric" data-rule-digits="true" data-msg-digits="Vul een heel aantal van minimaal 1 in." data-msg-number="Vul een heel aantal van minimaal 1 in." />
                                        <span asp-validation-for="Input.Tickets[i].Quantity"></span>
                                    </div>
                                    </div>
                                    <button type="button" class="portal-remove-ticket-btn">Verwijderen</button>
                                </div>
                                    
                                }
                            }
                    </div>
                </div>

                <!-- TOEGANKELIJKHEID -->

                <div class="portal-form-group--full">
                    <h2>Toegankelijkheid</h2>
                </div>

                <div class="portal-form-group">
                    <label asp-for="Input.ChildrenFriendly">Geschikt voor kinderen*</label>
                    <select asp-for="Input.ChildrenFriendly">
                        <option value="">Kies...</option>
                        <option value="true">Ja</option>
                        <option value="false">Nee</option>
                    </select>
                    <span asp-validation-for="Input.ChildrenFriendly"></span>
                </div>

                <div class="portal-form-group">
                    <label asp-for="Input.DisabledParkingAvailable">Invalidenparkeerplaats aanwezig*</label>
                    <select asp-for="Input.DisabledParkingAvailable">
                        <option value="">Kies...</option>
                        <option value="true">Ja</option>
                        <option value="false">Nee</option>
                    </select>
                    <span asp-validation-for="Input.DisabledParkingAvailable"></span>
                </div>

                <div class="portal-form-group">
                    <label asp-for="Input.DisabledToiletAvailable">Invalidentoilet aanwezig*</label>
                    <select asp-for="Input.DisabledToiletAvailable">
                        <option value="">Kies...</option>
                        <option value="true">Ja</option>
                        <option value="false">Nee</option>
                    </select>
                    <span asp-validation-for="Input.DisabledToiletAvailable"></span>
                </div>

                <div class="portal-form-group">
                    <label asp-for="Input.WheelchairAccessibleToilet">Rolstoeltoegankelijk toilet*</label>
                    <select asp-for="Input.WheelchairAccessibleToilet">
                        <option value="">Kies...</option>
                        <option value="true">Ja</option>
                        <option value="false">Nee</option>
                    </select>
                    <span asp-validation-for="Input.WheelchairAccessibleToilet"></span>
                </div>

                <div class="portal-form-group portal-form-group--full portal-category-picker"
                     data-category-picker
                     data-add-url="@Url.Page("/Portal/Create", "AddCategory")"
                     data-categories="@categoryOptionsJson">
                    <label for="category-search-input">Categorieën</label>

                    <div class="portal-tagbox portal-category-selected"
                         data-category-selected
                         aria-live="polite"></div>

                    <div class="portal-category-search">
                        <input id="category-search-input"
                               type="text"
                               class="portal-tag-input"
                               placeholder="Zoek een categorie of typ een nieuwe..."
                               autocomplete="off"
                               role="combobox"
                               aria-autocomplete="list"
                               aria-expanded="false"
                               aria-controls="category-suggestions"
                               data-category-search />

                        <div id="category-suggestions"
                             class="portal-category-suggestions"
                             role="listbox"
                             data-category-suggestions
                             hidden></div>
                    </div>

                    <div data-category-hidden>
                        @for (var i = 0; i < Model.Input.CategoryIds.Count; i++)
                        {
                            <input type="hidden" name="Input.CategoryIds[@i]" value="@Model.Input.CategoryIds[i]" />
                        }
                    </div>

                    <small class="portal-extra-help">Kies een bestaande categorie of voeg een nieuwe toe als deze nog niet bestaat.</small>
                    <p class="portal-category-feedback" data-category-feedback hidden></p>
                </div>

