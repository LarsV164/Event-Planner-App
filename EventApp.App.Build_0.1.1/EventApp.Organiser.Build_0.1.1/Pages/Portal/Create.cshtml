@page
@using System.Text.Json
@model EventApp.OrganiserPortal.Pages.Portal.CreateModel

@{
    ViewData["Title"] = "Evenement aanmaken";
    var vandaag = DateTime.Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
    var categoryOptionsJson = JsonSerializer.Serialize(
        Model.AvailableCategories.Select(category => new { id = category.CategoryId, name = category.CategoryName }));
}

@section Head {
    <link rel="stylesheet" href="~/css/pages/create.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/map.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/image-upload.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
}

<div class="portal-shell">
    <div class="portal-form-card">
        <h1>Evenement aanmaken</h1>
        <p>Gemarkeerde velden en velden met een * zijn verplicht.</p>

        <form id="create-event-form" method="post" enctype="multipart/form-data" class="portal-form">
            <div id="event-save-feedback" role="alert" tabindex="-1">
                <div asp-validation-summary="ModelOnly" class="portal-validation-summary"></div>
            </div>

            <div class="portal-form-grid">

                <!-- EVENT NAAM -->
                <div class="portal-form-group--full">
                    <h2>Evenement naam</h2>
                </div>


                <div class="portal-form-group">
                    <label asp-for="Input.EventName">Evenementnaam *</label>
                    <input asp-for="Input.EventName" maxlength="100" aria-describedby="event-name-help" />
                    <small id="event-name-help" class="portal-extra-help">Maximaal 100 tekens.</small>
                    <span asp-validation-for="Input.EventName"></span>
                </div>

                <!-- ORGINELE BESCHRIJVING VELD

                    <div class="portal-form-group portal-form-group--full">
                        <label asp-for="Input.Description">Beschrijving</label>
                        <textarea asp-for="Input.Description"></textarea>
                        <span asp-validation-for="Input.Description"></span>
                    </div>

                -->

                <!-- DATUM - TIJD -->

                <div class="portal-form-group--full">
                    <h2>Datum - Tijd</h2>
                </div>

                <div class="portal-form-group--full">
                    <div class="portal-form-grid">
                        <div class="portal-form-group">
                            <label asp-for="Input.StartDate"></label>
                            <input asp-for="Input.StartDate" type="date" min="@vandaag" max="9999-12-31" data-msg-min="Kies vandaag of een latere startdatum." data-msg-max="Gebruik een jaartal van maximaal 4 cijfers." />                            <span asp-validation-for="Input.StartDate"></span>
                        </div>

                        <div class="portal-form-group">
                            <label asp-for="Input.StartTime"></label>
                            <input asp-for="Input.StartTime" type="time" />
                            <span asp-validation-for="Input.StartTime"></span>
                        </div>

                        <div class="portal-form-group">
                            <label asp-for="Input.EndDate"></label>
                            <input asp-for="Input.EndDate" type="date" min="@vandaag" max="9999-12-31" data-msg-min="De einddatum mag niet vóór vandaag of vóór de startdatum liggen." data-msg-max="Gebruik een jaartal van maximaal 4 cijfers." />
                            <span asp-validation-for="Input.EndDate"></span>
                        </div>

                        <div class="portal-form-group">
                            <label asp-for="Input.EndTime"></label>
                            <input asp-for="Input.EndTime" type="time" />
                            <span asp-validation-for="Input.EndTime"></span>
                        </div>
                    </div>
                </div>

                <!-- LOCATIE -->

                <div class="portal-form-group--full">
                    <h2>Locatie</h2>
                </div>

                <div class="portal-form-group--full js-location-fields">
                    <div class="three-columns">
                        <div class="portal-form-group">
                            <label asp-for="Input.Street"></label>
                            <input asp-for="Input.Street" autocomplete="address-line1" />
                            <span asp-validation-for="Input.Street"></span>
                        </div>
                        <div class="portal-form-group portal-form-group-huisnummer">
                            <label asp-for="Input.HouseNumber"></label>
                            <input asp-for="Input.HouseNumber" type="text" inputmode="numeric" data-rule-digits="true" data-msg-digits="Vul een heel huisnummer van 1 of hoger in." data-msg-number="Vul een heel huisnummer van 1 of hoger in." />                            <span asp-validation-for="Input.HouseNumber"></span>
                        </div>
                        <div class="portal-form-group">
                            <label asp-for="Input.HouseNumberAddition"></label>
                            <input asp-for="Input.HouseNumberAddition" />
                        </div>
                    </div>
                </div>

                <div class="portal-form-group--full js-location-fields">
                    <div class="three-columns">
                        <div class="portal-form-group">
                            <label asp-for="Input.PostalCode"></label>
                            <input asp-for="Input.PostalCode" autocomplete="postal-code" />
                            <span asp-validation-for="Input.PostalCode"></span>
                        </div>
                        <div class="portal-form-group">
                            <label asp-for="Input.City"></label>
                            <input asp-for="Input.City" autocomplete="address-level2" />
                            <span asp-validation-for="Input.City"></span>
                        </div>
                        <div class="portal-form-group">
                            <label>Locatienaam</label>
                            <input type="text" />
                        </div>
                    </div>
                </div>

                <!-- ADRES EN KAART -->

                <div class="portal-form-group portal-form-group--full" id="map-group" hidden>
                    <div class="portal-form-group portal-form-group--full" id="address-group">
                        <label asp-for="Input.Address">Adres</label>
                        <div class="portal-address-row">
                            <input asp-for="Input.Address"
                                   id="address-input"
                                   placeholder="Zoek een plaats of adres" />
                            <button type="button" id="resolve-address-btn" class="portal-secondary-link">Zoek</button>
                        </div>
                        <span asp-validation-for="Input.Address"></span>
                    </div>

                    <label>Locatie kiezen</label>
                    <div class="portal-map-picker">
                        <div id="event-location-map" class="portal-map-canvas"></div>
                    </div>
                    <p class="portal-map-help">
                        Plaats een pin op de kaart of zoek een plaats. De dichtstbijzijnde match wordt automatisch gekozen.
                    </p>
                    <!-- <div id="map-status" class="portal-map-status" aria-live="polite"></div> -->
                    <span asp-validation-for="Input.Latitude"></span>
                    <span asp-validation-for="Input.Longitude"></span>
                </div>

                <input asp-for="Input.Latitude" type="hidden" id="latitude-input" />
                <input asp-for="Input.Longitude" type="hidden" id="longitude-input" />
                <input asp-for="Input.NoAddressMode" type="hidden" id="no-address-mode-input" />

                <div class="portal-form-group portal-form-group--full">
                    <div class="portal-form-group">
                        <button type="button" id="no-address-btn" class="portal-secondary-link">Geen Adres Beschikbaar</button>
                    </div>
                </div>
                

                

                <!-- MEDIA -->

                <div class="portal-form-group--full">
                    <h2>Media</h2>
                    <p class="portal-image-help">
                        Upload maximaal 10 afbeeldingen. Afbeeldingen worden vierkant bijgesneden. Klik op een afbeelding om de positie aan te passen.
                    </p>
                    <p></p>
                    <p class="portal-image-help" id="image-count">
                        0/10
                    </p>
                </div>

                <div class="portal-form-group portal-form-group--full portal-image-upload">
                    <div class="portal-form-group">
                        <button type="button" id="add-images-btn" class="portal-secondary-link" aria-describedby="images-error">Selecteer of sleep afbeeldingen</button>                    </div>
                    <input id="images-input" name="Images" type="file" accept="image/*" multiple hidden />

                    <div class="portal-image-strip-shell" id="image-strip-shell" hidden>
                        <div id="image-strip" class="portal-image-strip"></div>
                    </div>

                    <div id="image-meta-inputs"></div>
                    <span asp-validation-for="Images" id="images-error" aria-live="polite"></span>

                </div>

                <div id="image-position-modal" class="portal-image-modal" hidden>
                    <div class="portal-image-modal-card">
                        <div class="portal-image-modal-header">
                            <h3>Afbeelding positioneren</h3>
                            <button type="button" id="close-image-modal" class="portal-image-modal-close">×</button>
                        </div>

                        <div class="portal-image-modal-preview-wrap">
                            <div class="portal-image-modal-preview">
                                <img id="position-preview-image" alt="Voorbeeld van afbeelding uitsnede" />
                            </div>
                        </div>

                        <div class="portal-image-modal-controls">
                            <label for="position-x-range">Horizontale positie</label>
                            <input id="position-x-range" type="range" min="0" max="100" step="1" value="50" />

                            <label for="position-y-range">Verticale positie</label>
                            <input id="position-y-range" type="range" min="0" max="100" step="1" value="50" />
                        </div>

                        <div class="portal-image-modal-actions">
                            <button type="button" id="save-image-position" class="auth-submit-btn">Opslaan</button>
                        </div>
                    </div>
                </div>


                                        
                <!-- ORIGINELE AFBEELDING TOEVOEGEN

                <div class="portal-form-group portal-form-group--full portal-image-upload">
                    <label>Afbeeldingen</label>

                    <input id="images-input" name="Images" type="file" accept="image/*" multiple hidden />

                    <div class="portal-image-strip-shell">
                        <div id="image-strip" class="portal-image-strip"></div>
                    </div>

                    <div id="image-meta-inputs"></div>

                    <p class="portal-image-help">
                        Upload maximaal 10 afbeeldingen. Afbeeldingen worden vierkant bijgesneden. Je kunt de positie per afbeelding aanpassen.
                    </p>
