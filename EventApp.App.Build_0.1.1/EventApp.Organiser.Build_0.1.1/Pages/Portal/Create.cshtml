                <details class="portal-extras portal-form-group--full" open="@(ViewData.ModelState.IsValid ? null : "open")">

                    <summary class="portal-extras-heading">
                        Extra's
                    </summary>

                    <div class="portal-form-grid portal-extras-content">

                        <p class="portal-form-group--full portal-extra-help">
                            De onderstaande velden zijn optioneel.
                        </p>

                        <div class="portal-form-group">
                            <label asp-for="Input.ContactPhone"></label>
                            <input asp-for="Input.ContactPhone" type="tel" autocomplete="tel" maxlength="30" placeholder="Bijvoorbeeld 06 12345678" />
                            <span asp-validation-for="Input.ContactPhone"></span>
                        </div>

                        <div class="portal-form-group">
                            <label asp-for="Input.ContactEmail"></label>
