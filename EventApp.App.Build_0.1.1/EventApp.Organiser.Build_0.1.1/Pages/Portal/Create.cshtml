    <script>
        (() => {
            const addButton = document.getElementById('add-ticket-btn');
            const list = document.getElementById('ticket-list');
            const template = document.getElementById('ticket-row-template');

            if (!addButton || !list || !template) return;

            function reindexTickets() {
                list.querySelectorAll('.portal-ticket-row').forEach((row, index) => {
                    for (const field of ['TicketType', 'Price', 'Quantity']) {
                        const input = row.querySelector(`[name$=".${field}"]`);
                        const label = row.querySelector(`label[for$="__${field}"]`);
                        const message = row.querySelector(`[data-valmsg-for$=".${field}"]`);

                        if (!input) continue;

                        input.name = `Input.Tickets[${index}].${field}`;
                        input.id = `Input_Tickets_${index}__${field}`;

                        if (label) label.htmlFor = input.id;
                        if (message) message.setAttribute('data-valmsg-for', input.name);
                    }
                });
            }

            addButton.addEventListener('click', () => {
                list.appendChild(template.content.cloneNode(true));
                reindexTickets();
                list.lastElementChild.querySelector('input[name$=".TicketType"]')?.focus();
            });

            list.addEventListener('click', event => {
                const removeButton = event.target.closest('.portal-remove-ticket-btn');
                if (!removeButton) return;

                removeButton.closest('.portal-ticket-row')?.remove();
                reindexTickets();
            });
        })();
    </script>
    <script>

        (() => {
            function setupTagInput(config) {
                const input = document.getElementById(config.inputId);
                const tagbox = document.getElementById(config.tagboxId);
                const hiddenInputs = document.getElementById(config.hiddenInputsId);

                if (!input || !tagbox || !hiddenInputs) return;

                const values = Array.from(hiddenInputs.querySelectorAll('input[type="hidden"]'))
                    .map(x => x.value)
                    .filter(x => x && x.trim() !== '');

                function render() {
                    tagbox.innerHTML = '';
                    hiddenInputs.innerHTML = '';

                    values.forEach((value, index) => {
                        const tag = document.createElement('button');
                        tag.type = 'button';
                        tag.className = 'portal-tag';
                        tag.innerHTML = `<span>${value}</span><span aria-hidden="true">×</span>`;
                        tag.addEventListener('click', () => {
                            values.splice(index, 1);
                            render();
                        });

                        tagbox.appendChild(tag);

                        const hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = `${config.name}[${index}]`;
                        hidden.value = value;
                        hiddenInputs.appendChild(hidden);
                    });
                }

                function addValue(rawValue) {
                    const value = rawValue.trim();
                    if (!value) return;
                    if (values.some(x => x.toLowerCase() === value.toLowerCase())) return;

                    values.push(value);
                    input.value = '';
                    render();
                }

                input.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter' || event.key === ',') {
                        event.preventDefault();
                        addValue(input.value);
                    }
                });

                input.addEventListener('blur', () => {
                    if (input.value.trim() !== '') {
                        addValue(input.value);
                    }
                });

                render();
            }

            setupTagInput({
                inputId: 'categories-input',
                tagboxId: 'categories-tagbox',
                hiddenInputsId: 'categories-hidden-inputs',
                name: 'Input.Categories'
            });

            setupTagInput({
                inputId: 'accessibility-input',
                tagboxId: 'accessibility-tagbox',
                hiddenInputsId: 'accessibility-hidden-inputs',
                name: 'Input.AccessibilityOptions'
            });
        })();
    </script>
    <script>
        (() => {
            const input = document.getElementById('attachments-input');
            const button = document.getElementById('add-attachments-btn');
            const zone = document.getElementById('attachments-upload');
            const shell = document.getElementById('attachments-list-shell');
            const list = document.getElementById('attachments-list');

            if (!input || !button || !zone || !shell || !list) return;

            let files = Array.from(input.files);

            function updateFiles() {
                const transfer = new DataTransfer();

                files.forEach(file => transfer.items.add(file));
                input.files = transfer.files;

                list.replaceChildren();
                shell.hidden = files.length === 0;

                files.forEach((file, index) => {
                    const item = document.createElement('li');

                    const name = document.createElement('span');
                    name.className = 'portal-attachment-name';
                    name.textContent = file.name;

                    const remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'portal-attachment-remove';
                    remove.textContent = 'Verwijderen';
                    remove.setAttribute('aria-label', `${file.name} verwijderen`);

                    remove.addEventListener('click', () => {
                        files.splice(index, 1);
                        updateFiles();
                    });

                    item.append(name, remove);
                    list.appendChild(item);
                });
            }

            function addFiles(selectedFiles) {
                for (const file of selectedFiles) {
                    const alreadyAdded = files.some(existing =>
                        existing.name === file.name &&
                        existing.size === file.size &&
                        existing.lastModified === file.lastModified
                    );

                    if (!alreadyAdded) files.push(file);
                }

                updateFiles();
            }

            button.addEventListener('click', () => input.click());

            input.addEventListener('change', () => {
                addFiles(Array.from(input.files));
            });

            zone.addEventListener('dragover', event => {
                event.preventDefault();
            });

            zone.addEventListener('drop', event => {
                event.preventDefault();
                addFiles(Array.from(event.dataTransfer.files));
            });

            updateFiles();
        })();
    </script>
    <script>
        jQuery(function ($) {
            const form = document.getElementById('create-event-form');
            if (!form) return;

            if (!$(form).data('validator')) {
                $.validator.unobtrusive.parse(form);
            }

            const validator = $(form).data('validator');
            if (!validator) return;

            const fields = 'input[name]:not([type="hidden"]):not([type="file"]), select[name], textarea[name]';

            function validateField(field) {
                if (field.disabled || !$(field).is(':visible')) return;

                const invalid = validator.element(field) === false;
                field.classList.toggle('input-validation-error', invalid);
                field.setAttribute('aria-invalid', String(invalid));
            }

            // Controleer ingevulde tekst en keuzes direct tijdens het invoeren.
            $(form).on('input change', fields, function () {
                if (this.value !== '' || this.classList.contains('input-validation-error')) {
                    validateField(this);
                }
            });

            // Toon ook de melding voor een leeg verplicht veld wanneer je het verlaat.
            $(form).on('focusout', fields, function () {
                validateField(this);
            });
        });
    </script>
