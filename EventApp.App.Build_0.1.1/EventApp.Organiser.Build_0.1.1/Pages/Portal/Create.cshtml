                    <div class="portal-image-modal-card">
                        <div class="portal-image-modal-header">
                            <h3>Afbeelding positioneren</h3>
                            <button type="button" id="close-image-modal" class="portal-image-modal-close">×</button>
                        </div>

                        <div class="portal-image-modal-preview-wrap">
                            <div class="portal-image-modal-preview">
                                <img id="position-preview-image" alt="Voorbeeld van afbeelding uitsnede" />
                            </div>
                        </div>

                        <div class="portal-image-modal-controls">
                            <label for="position-x-range">Horizontale positie</label>
                            <input id="position-x-range" type="range" min="0" max="100" step="1" value="50" />

                            <label for="position-y-range">Verticale positie</label>
                            <input id="position-y-range" type="range" min="0" max="100" step="1" value="50" />
                        </div>

                        <div class="portal-image-modal-actions">
                            <button type="button" id="save-image-position" class="auth-submit-btn">Opslaan</button>
                        </div>
                    </div>
                </div>

                -->

                <!-- BESCHRIJVING -->

                <div class="portal-form-group--full">
                    <h2>Beschrijving</h2>
                </div>

                <div class="portal-form-group portal-form-group--full">
                    <textarea asp-for="Input.Description"></textarea>
                    <span asp-validation-for="Input.Description"></span>
                </div>

                
                <!-- TICKETS -->
                <div class="portal-form-group--full">
                    <h2>Tickets</h2>
                </div>

                <div class="portal-form-group portal-form-group--full">
                    <button type="button" id="add-ticket-btn" class="portal-secondary-link">Ticket toevoegen</button>

                    <div id="ticket-list" class="portal-ticket-list">
                        @if (Model.Input.Tickets != null && Model.Input.Tickets.Count > 0)
                            {
                                for (var i = 0; i < Model.Input.Tickets.Count; i++)
                                {
                                <div class="portal-ticket-row">
                                    <div class="three-columns">
                                        <div class="portal-form-group">
                                            <label asp-for="Input.Tickets[i].TicketType">Ticketsoort</label>
                                            <select asp-for="Input.Tickets[i].TicketType" asp-items="Model.TicketTypeOptions">
                                                <option value="">-- Kies een ticketsoort --</option>
                                            </select>
                                            <span asp-validation-for="Input.Tickets[i].TicketType"></span>
                                        </div>

                                        <div class="portal-form-group">
                                            <label asp-for="Input.Tickets[i].Price">Prijs</label>
                                            <input asp-for="Input.Tickets[i].Price" type="number" step="0.01" min="0" />
                                            <span asp-validation-for="Input.Tickets[i].Price"></span>
                                        </div>

                                        <div class="portal-form-group">
                                            <label asp-for="Input.Tickets[i].Quantity">Aantal beschikbaar</label>
                                            <input asp-for="Input.Tickets[i].Quantity" type="number" step="1" min="1" />
                                            <span asp-validation-for="Input.Tickets[i].Quantity"></span>
                                        </div>
                                    </div>
                                    <button type="button" class="portal-remove-ticket-btn">Verwijderen</button>
                                </div>
                                    
