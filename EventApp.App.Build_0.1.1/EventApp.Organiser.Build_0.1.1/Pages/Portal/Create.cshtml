@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>

    <script src="~/js/create-event-map.js" asp-append-version="true"></script>

    <script src="~/js/image-upload-strip.js" asp-append-version="true"></script>

    <script>
        (() => {
            const ticketList = document.getElementById('ticket-list');
            const addTicketBtn = document.getElementById('add-ticket-btn');

            function getTicketCount() {
                return ticketList.querySelectorAll('.portal-ticket-row').length;
            }

            function createTicketRow(index) {
                const row = document.createElement('div');
                row.className = 'portal-ticket-row';

                row.innerHTML = `
                    <div class="three-columns">
                        <div class="portal-form-group">
                            <label for="Input_Tickets_${index}__TicketType">Ticketsoort</label>
                            <select id="Input_Tickets_${index}__TicketType" name="Input.Tickets[${index}].TicketType">
                                <option value="">-- Kies een ticketsoort --</option>
                                <option value="Sta-Ticket">Sta-Ticket</option>
                                <option value="Zit-Ticket">Zit-Ticket</option>
                                <option value="Invalide-Ticket">Invalide-Ticket</option>
                                <option value="VIP-Ticket">VIP-Ticket</option>
                            </select>
                        </div>
                        <div class="portal-form-group">
                            <label for="Input_Tickets_${index}__Price">Prijs</label>
                            <input id="Input_Tickets_${index}__Price" name="Input.Tickets[${index}].Price" type="number" step="0.01" min="0" value="0" />
                        </div>
                        <div class="portal-form-group">
                            <label for="Input_Tickets_${index}__Quantity">Aantal beschikbaar</label>
                            <input id="Input_Tickets_${index}__Quantity" name="Input.Tickets[${index}].Quantity" type="number" step="1" min="1" value="1" />
                        </div>
                    </div>
                    <button type="button" class="portal-remove-ticket-btn">Verwijderen</button>
                `;

                return row;
            }

            function reindexTickets() {
                ticketList.querySelectorAll('.portal-ticket-row').forEach((row, index) => {
                    ['TicketType', 'Price', 'Quantity'].forEach(field => {
                        const input = row.querySelector(`input[name$=".${field}"]`);
                        const label = row.querySelector(`label[for$="__${field}"]`);
                        if (input) {
                            input.id = `Input_Tickets_${index}__${field}`;
                            input.name = `Input.Tickets[${index}].${field}`;
                        }
                        if (label) label.setAttribute('for', `Input_Tickets_${index}__${field}`);
                    });
                });
            }

            if (addTicketBtn && ticketList) {
                addTicketBtn.addEventListener('click', () => {
                    const index = getTicketCount();
                    ticketList.appendChild(createTicketRow(index));
                });

                ticketList.addEventListener('click', (event) => {
                    const removeBtn = event.target.closest('.portal-remove-ticket-btn');
                    if (!removeBtn) return;

                    const row = removeBtn.closest('.portal-ticket-row');
                    if (!row) return;

                    row.remove();
                    reindexTickets();
                });
            }
        })();

        (() => {
            function setupTagInput(config) {
                const input = document.getElementById(config.inputId);
                const tagbox = document.getElementById(config.tagboxId);
                const hiddenInputs = document.getElementById(config.hiddenInputsId);

                if (!input || !tagbox || !hiddenInputs) return;

                const values = Array.from(hiddenInputs.querySelectorAll('input[type="hidden"]'))
                    .map(x => x.value)
                    .filter(x => x && x.trim() !== '');

                function render() {
                    tagbox.innerHTML = '';
                    hiddenInputs.innerHTML = '';

                    values.forEach((value, index) => {
                        const tag = document.createElement('button');
                        tag.type = 'button';
                        tag.className = 'portal-tag';
                        tag.innerHTML = `<span>${value}</span><span aria-hidden="true">×</span>`;
                        tag.addEventListener('click', () => {
                            values.splice(index, 1);
                            render();
                        });

                        tagbox.appendChild(tag);

                        const hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = `${config.name}[${index}]`;
                        hidden.value = value;
                        hiddenInputs.appendChild(hidden);
                    });
                }

                function addValue(rawValue) {
                    const value = rawValue.trim();
                    if (!value) return;
                    if (values.some(x => x.toLowerCase() === value.toLowerCase())) return;

                    values.push(value);
                    input.value = '';
                    render();
                }

                input.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter' || event.key === ',') {
                        event.preventDefault();
                        addValue(input.value);
                    }
                });

                input.addEventListener('blur', () => {
                    if (input.value.trim() !== '') {
                        addValue(input.value);
                    }
                });

                render();
            }

            setupTagInput({
                inputId: 'categories-input',
                tagboxId: 'categories-tagbox',
                hiddenInputsId: 'categories-hidden-inputs',
                name: 'Input.Categories'
            });

            setupTagInput({
                inputId: 'accessibility-input',
                tagboxId: 'accessibility-tagbox',
                hiddenInputsId: 'accessibility-hidden-inputs',
                name: 'Input.AccessibilityOptions'
            });
        })();
    </script>
}