@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/category-picker.js" asp-append-version="true"></script>

    <script>
        jQuery(function ($) {
            const form = document.querySelector('form.portal-form');
            if (!form) return;

            const startDate = form.elements.namedItem('Input.StartDate');
            const endDate = form.elements.namedItem('Input.EndDate');
            const startTime = form.elements.namedItem('Input.StartTime');
            const endTime = form.elements.namedItem('Input.EndTime');
            const today = startDate.min;
            if (!$(form).data('validator')) {
                $.validator.unobtrusive.parse(form);
            }

            const validator = $(form).data('validator');
            if (!validator) return;

            $.validator.addMethod('latereindtijd', function (value) {
                if (!value || !startTime.value || !startDate.value || !endDate.value) return true;
                if (startDate.value !== endDate.value) return true;

                return endTime.valueAsNumber > startTime.valueAsNumber;
            }, 'Kies een eindtijd die later is dan de starttijd.');

            $(endTime).rules('add', { latereindtijd: true });

            function updateDates() {
                endDate.min = startDate.value > today ? startDate.value : today;

                if (endDate.value) validator.element(endDate);
                if (endTime.value) validator.element(endTime);
            }

            for (const field of [startDate, endDate]) {
                field.addEventListener('input', () => {
                    const year = field.value.split('-')[0];

                    if (year.length > 4) {
                        field.value = '';
                        validator.showErrors({
                            [field.name]: 'Gebruik een jaartal van maximaal 4 cijfers.'
                        });
                    }
                });
            }

            for (const field of [startDate, endDate, startTime, endTime]) {
                field.addEventListener('change', updateDates);
            }

            updateDates();
        });
    </script>

